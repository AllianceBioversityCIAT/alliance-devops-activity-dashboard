AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=jenkinsexecutions_test
# Optional: max DynamoDB items evaluated per Dashboard /api/deployments request (default 200000). Executive Summary uses Query (see EXEC_SUMMARY_* below), not this cap.
# DASHBOARD_DYNAMO_MAX_SCANNED_ITEMS=200000

# Executive Summary: Query-only (no Scan on executions). Required for job_gsi (default):
# EXEC_SUMMARY_EXECUTIONS_STRATEGY=job_gsi
# EXEC_SUMMARY_JOB_GSI_NAME=your-gsi-name
# EXEC_SUMMARY_JOB_GSI_PK=job
# EXEC_SUMMARY_JOB_GSI_SK=buildDate
# Optional: month_gsi (requires buildMonth + buildDate GSI and items populated with buildMonth YYYY-MM)
# EXEC_SUMMARY_EXECUTIONS_STRATEGY=month_gsi
# EXEC_SUMMARY_MONTH_GSI_NAME=
# EXEC_SUMMARY_MONTH_GSI_PK=buildMonth
# EXEC_SUMMARY_MONTH_GSI_SK=buildDate
# EXEC_SUMMARY_JOB_QUERY_CONCURRENCY=15
# Optional: partition key job_name; attributes application_name, project_name; optional environment on item. Omit to skip metadata lookups (OTHERS fallback).
DYNAMODB_DEPLOYMENT_METADATA_TABLE_NAME=deployment_metadata
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
COGNITO_DOMAIN=
FRONTEND_REDIRECT_URI=http://localhost:4200/auth
COGNITO_IDENTITY_PROVIDER=AzureAD
LOG_LEVEL=info
PORT=4000
